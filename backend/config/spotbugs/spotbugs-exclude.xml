<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring constructor-injected components, records, and DTOs intentionally hold injected singletons/values -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Java SQL text blocks using .formatted(...) intentionally preserve LF line endings -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <!-- Spring beans fail fast in constructors while staying non-final for proxies on Java 21 (finalizers deprecated) -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
